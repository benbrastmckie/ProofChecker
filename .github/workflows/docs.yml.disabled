name: API Documentation

# DISABLED (renamed to docs.yml.disabled -- GitHub Actions only picks up files directly under
# .github/workflows/ ending in .yml/.yaml, so this file no longer runs at all, on push or
# manually).
#
# leanprover-community/docgen-action@main hard-requires a `lakefile.toml`: its
# determine-project-metadata step does `fs.readFileSync("lakefile.toml")` with no fallback for
# a Lean-syntax lakefile, in every commit of that action back to its first. This repository's
# canonical build file is `lakefile.lean` (see CLAUDE.md), so every run of this workflow failed
# at that step with "Could not find `lakefile.toml`" -- not a misconfiguration here, a hard
# incompatibility with this project's lakefile format.
#
# To re-enable: rename this file back to `docs.yml`, and first do ONE of:
#   (a) migrate the project to a `lakefile.toml` (a real build-config change: verify every
#       setting survives the translation -- Mathlib pin, lean_exe roots, lint config -- and that
#       `lake build` still passes), or
#   (b) confirm docgen-action has added lakefile.lean support upstream.
#
# Builds the doc-gen4 API documentation for FormalSystem and deploys it to GitHub Pages.
#
# The action supplies doc-gen4 itself, which is why `lakefile.lean` and `lake-manifest.json`
# carry no doc-gen4 dependency and must not acquire one: adding it would put doc-gen4 into
# every contributor's `lake build` for the sake of a job that only runs here.
#
# `build-page: false` is load-bearing, not a default being restated. The action's `homepage`
# input defaults to `docs`, and it expects that folder to be a Jekyll site whose `docs/docs/`
# subdirectory receives the generated API pages. This repository's `docs/` is a hand-maintained
# tree of ~100 markdown files with no `_config.yml`, so letting the action Jekyll-build it would
# either fail or publish something nobody wrote. Turning the landing page off publishes the API
# documentation alone. The upgrade path, if a landing page is ever wanted, is `homepage: website`
# pointing at a real Jekyll site in a new folder -- never `docs`.
#
# ONE-TIME MANUAL STEP: the repository's Pages source must be set to "GitHub Actions"
# (Settings -> Pages -> Build and deployment -> Source). A workflow cannot set this for itself,
# and until it is set the deploy step has nowhere to publish.

on:
  push:
    branches: ["main"]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

# One deployment at a time; a queued run supersedes an older queued run but never cancels a
# deploy already in flight.
concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  docs:
    name: Build and deploy API documentation
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.docgen.outputs.page_url }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Build and deploy doc-gen4 documentation
        id: docgen
        uses: leanprover-community/docgen-action@main
        with:
          api-docs: true
          blueprint: false
          build-page: false
          references: references.bib
